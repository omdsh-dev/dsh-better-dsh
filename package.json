{
  "name": "dsh-better-dsh",
  "version": "0.11.5",
  "description": "Better DSH: a DSH plugin bundle that installs workflow skills, engineering presets, and five independent plugins (goal, subagent, compact, ask-user, ptc). Pure ESM, no build step.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-better-dsh.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:packages": "pnpm -r --if-present --filter '!dsh-lazy-session-list' test",
    "test:lazy-session-list": "pnpm --filter dsh-lazy-session-list test",
    "build:packages": "pnpm -r --if-present build",
    "test:all": "pnpm test && pnpm test:packages",
    "prompts": "node scripts/render-prompts.mjs",
    "smoke": "node scripts/runtime-smoke.mjs"
  },
  "files": [
    "src",
    "docs/DEVELOPMENT.md",
    "docs/UI-KIT.md",
    "docs/assets",
    "skills",
    "presets",
    "third-party",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "better-dsh",
    "omdsh-dev",
    "workflow",
    "orchestration",
    "agent-preset"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.2",
    "@deepseek-ai/dsh-command-goal": "0.2.2-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.2",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.2-rc.2",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-goal": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.2",
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@oh-my-dsh/dsh-better-subagent": "0.5.3",
    "dsh-better-ask-user": "0.3.5",
    "dsh-better-compact": "0.4.1",
    "dsh-better-goal": "0.4.4",
    "dsh-better-ptc": "0.2.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/eng.patch.yml",
        "./presets/eng-ptc.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "homepage": "https://github.com/omdsh-dev/dsh-better-dsh#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-better-dsh/issues"
  },
  "packageManager": "pnpm@11.7.0"
}
