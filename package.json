{
  "name": "dsh-better-dsh",
  "version": "0.12.2-alpha.2",
  "description": "Better DSH: a DSH plugin bundle that installs workflow skills, engineering presets, and five independent plugins (goal, subagent, compact, ask-user, ptc). TypeScript sources compiled to ESM.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-better-dsh.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.3 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs && node scripts/build-presets.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.presets.json && pnpm -r --if-present typecheck",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:packages": "pnpm -r --if-present --filter '!dsh-lazy-session-list' test",
    "test:lazy-session-list": "pnpm --filter dsh-lazy-session-list test",
    "build:packages": "pnpm -r --if-present build",
    "build:all": "pnpm build && pnpm build:packages",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:packages",
    "preprompts": "pnpm build:all",
    "prompts": "node scripts/render-prompts.mjs",
    "presmoke": "pnpm build:all",
    "smoke": "node scripts/runtime-smoke.mjs"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "docs/DEVELOPMENT.md",
    "docs/UI-KIT.md",
    "docs/assets",
    "skills",
    "presets/eng.patch.yml",
    "presets/eng-ptc.patch.yml",
    "presets/eng/NOTICE",
    "presets/eng/plugins/exit-guard/lib/**/*.js",
    "presets/eng/plugins/exit-guard/lib/**/*.js.map",
    "presets/eng/plugins/exit-guard/package.json",
    "presets/eng/plugins/mode-instructions/lib/**/*.js",
    "presets/eng/plugins/mode-instructions/lib/**/*.js.map",
    "presets/eng/plugins/mode-instructions/package.json",
    "third-party",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "better-dsh",
    "omdsh-dev",
    "workflow",
    "orchestration",
    "agent-preset"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-agent-preset": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-attachment": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-brand": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-connection": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-command-goal": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-commands": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-compaction": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-config-editor": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-error": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-goal": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-jobs": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-scope": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-session-query": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-skill": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-storage": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-storage-json": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-subprocess": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-token-meter": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-tool-goal": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-user-questions": "0.2.3-alpha.3",
    "@deepseek-ai/dsh-working-directory": "0.2.3-alpha.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.25.0",
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.20.0-alpha.2",
    "@oh-my-dsh/dsh-better-subagent": "0.5.7-alpha.1",
    "dsh-better-ask-user": "0.3.9-alpha.2",
    "dsh-better-compact": "0.5.3-alpha.1",
    "dsh-better-goal": "0.4.8-alpha.1",
    "dsh-better-ptc": "0.2.4-alpha.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/eng.patch.yml",
        "./presets/eng-ptc.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "homepage": "https://github.com/omdsh-dev/dsh-better-dsh#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-better-dsh/issues"
  },
  "packageManager": "pnpm@11.7.0"
}
