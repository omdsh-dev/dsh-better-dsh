{
  "name": "@oh-my-dsh/dsh-better-subagent",
  "version": "0.5.7-alpha.1",
  "description": "Standalone DSH plugin: Codex/Claude continuable CLI subagents, wait_subagent, child exit guard and model tiers. TypeScript sources compiled to ESM.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-better-subagent.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.3 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build",
    "smoke": "node scripts/runtime-smoke.mjs"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "third-party"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "subagent",
    "codex",
    "claude",
    "cli"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.20.0-alpha.2",
    "dsh-better-ptc": "0.2.4-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-storage-json": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.3-alpha.3 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.25.0",
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "homepage": "https://github.com/omdsh-dev/dsh-better-subagent#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-better-subagent/issues"
  }
}
