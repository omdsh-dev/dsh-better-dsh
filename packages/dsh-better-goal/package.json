{
  "name": "dsh-better-goal",
  "version": "0.4.7-alpha.1",
  "description": "Independent DSH goal plugin: one goal tool, persistent continuation, hot settings and native-compatible history.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-better-goal.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build",
    "smoke": "node scripts/runtime-smoke.mjs"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "third-party"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.20.0-alpha.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-command-goal": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-goal": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-goal-round-driver": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-tool-goal": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.3-alpha.2 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-command-goal": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-goal": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-goal": "0.2.3-alpha.2",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.25.0",
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "homepage": "https://github.com/omdsh-dev/dsh-better-goal#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-better-goal/issues"
  }
}
