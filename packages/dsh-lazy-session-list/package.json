{
  "name": "dsh-lazy-session-list",
  "version": "0.2.0",
  "description": "Keep a configurable native session-list index and defer other projections to per-session loading.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-lazy-session-list.git"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-lazy-session-list#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-lazy-session-list/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build",
    "smoke": "node scripts/live-smoke.mjs"
  },
  "files": [
    "lib",
    "docs/assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/schemastery": "~3.20.0-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.3-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
