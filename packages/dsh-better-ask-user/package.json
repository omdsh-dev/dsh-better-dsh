{
  "name": "dsh-better-ask-user",
  "version": "0.3.9-alpha.1",
  "description": "Independent ask_user_question plugin: configurable wait, input-extended countdown, markdown/mobile card, native or default timeout behavior, and PTC deadline exemption.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-better-dsh.git",
    "directory": "packages/dsh-better-ask-user"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.3 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.20.0-alpha.2",
    "dsh-better-ptc": "0.2.4-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.3-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.3-alpha.3 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "homepage": "https://github.com/omdsh-dev/dsh-better-dsh/tree/main/packages/dsh-better-ask-user#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-better-dsh/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
